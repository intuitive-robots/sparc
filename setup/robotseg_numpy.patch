+def load_video_frames_from_numpy(
+    frames,
+    image_size,
+    offload_video_to_cpu,
+    img_mean=(0.485, 0.456, 0.406),
+    img_std=(0.229, 0.224, 0.225),
+    compute_device=torch.device("cuda"),
+):
+    """Load video frames directly from a (T, H, W, 3) uint8 numpy array, no disk I/O."""
+    import torch.nn.functional as F
+    T, video_height, video_width = frames.shape[:3]
+    img_mean_t = torch.tensor(img_mean, dtype=torch.float32)[:, None, None]
+    img_std_t = torch.tensor(img_std, dtype=torch.float32)[:, None, None]
+
+    # (T, H, W, 3) uint8 -> (T, 3, H, W) float32 in [0, 1]
+    images = torch.from_numpy(frames).permute(0, 3, 1, 2).float() / 255.0
+    # resize to image_size x image_size
+    images = F.interpolate(images, size=(image_size, image_size), mode="bilinear", align_corners=False)
+
+    if not offload_video_to_cpu:
+        images = images.to(compute_device)
+        img_mean_t = img_mean_t.to(compute_device)
+        img_std_t = img_std_t.to(compute_device)
+    images -= img_mean_t
+    images /= img_std_t
+    return images, video_height, video_width
 
 
